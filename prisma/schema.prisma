generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  current
  completed
  store
}

enum AlertType {
  ACCOUNTING_OVERDUE
}

model Office {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  leaf_alert_days Int              @default(2)
  books           Book[]
  employees       EmployeeOffice[]

  @@map("offices")
}

model Employee {
  id           Int              @id @default(autoincrement())
  name         String
  role         String
  password     String?
  consumptions Consumption[]
  offices      EmployeeOffice[]

  @@map("employee")
}

model EmployeeOffice {
  employee_id Int
  office_id   Int
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  office      Office   @relation(fields: [office_id], references: [id], onDelete: Cascade)

  @@id([employee_id, office_id])
  @@map("employee_office")
}

model Book {
  id                     Int        @id @default(autoincrement())
  office_id              Int?
  office                 Office?    @relation(fields: [office_id], references: [id])
  book_number            String     @unique
  initial_assigned_date  DateTime?  @db.Date
  leaf_no_from           Int?
  leaf_no_to             Int?
  /// Calendar year this book's leaf_no_from/leaf_no_to range belongs to; raw leaf numbers restart at 1 each year, scoped by this field.
  leaf_year              Int?
  book_status            BookStatus
  in_floor               Boolean    @default(false)
  lot_number             String?
  lot                    Lot?       @relation(fields: [lot_number], references: [lot_number])
  consumptions           Consumption[]
  alerts                 Alert[]

  @@map("book")
}

model Lot {
  id          Int      @id @default(autoincrement())
  lot_number  String   @unique
  book_from   Int
  book_to     Int
  created_at  DateTime @default(now())
  books       Book[]

  @@map("lot")
}

model Consumption {
  book_id         Int
  leaf_no         String
  book            Book      @relation(fields: [book_id], references: [id], onDelete: Cascade)
  user_id         Int?
  employee        Employee? @relation(fields: [user_id], references: [id])
  assigned_date   DateTime  @db.Date
  accounted       Boolean   @default(false)
  accounted_date  DateTime? @db.Date

  @@id([book_id, leaf_no])
  @@map("consumption")
}

model Alert {
  id        Int       @id @default(autoincrement())
  type      AlertType
  book_id   Int?
  book      Book?     @relation(fields: [book_id], references: [id], onDelete: Cascade)
  payload   Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  resolvedAt DateTime?

  @@unique([type, book_id])
  @@map("alert")
}
